# Copy to .env on the VPS. Replace every CHANGE_ME value and never commit .env.
# On the VPS: chmod 600 .env; owner = only the account which runs Docker Compose.
CONTENT_ROOT=/srv/ddg-content

POSTGRES_DB=ddg_content
POSTGRES_USER=ddg_content
# Use only URL-safe characters (hex is ideal); the value is also embedded in
# DATABASE_URL. Do not use $, @, :, /, # or %. Example generator: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_HEX_POSTGRES_PASSWORD

# Generate once with a cryptographically secure password manager and do not rotate casually.
PAYLOAD_SECRET=CHANGE_ME_64_OR_MORE_RANDOM_CHARACTERS

# Future HTTPS origins. They are not opened or configured by these files.
PAYLOAD_PUBLIC_SERVER_URL=https://admin.example.com
PUBLIC_MEDIA_ORIGIN=https://content.example.com
SITE_ORIGIN=https://example.com

# Keep Payload private on ddg-bridge-01 even if firewall rules change.
PAYLOAD_BIND_ADDRESS=127.0.0.1
PAYLOAD_PORT=3000
