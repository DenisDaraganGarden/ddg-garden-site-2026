[Unit]
Description=DDG content admin reverse SSH tunnel to nigrita
Documentation=file:///etc/ddg-content-tunnel/ssh_config
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=5min
StartLimitBurst=6

[Service]
Type=simple
User=ddg-content-tunnel-client
Group=ddg-content-tunnel-client
ExecStartPre=/usr/bin/test -r /etc/ddg-content-tunnel/id_ed25519
ExecStartPre=/usr/bin/test -r /etc/ddg-content-tunnel/known_hosts
ExecStart=/usr/bin/ssh -F /etc/ddg-content-tunnel/ssh_config -N -T -R 127.0.0.1:18055:127.0.0.1:3000 ddg-content-gateway
Restart=always
RestartSec=10s

# The service needs only its SSH key and local loopback network access.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
UMask=0077
ReadOnlyPaths=/etc/ddg-content-tunnel

[Install]
WantedBy=multi-user.target
