# Install as /etc/ddg-content-tunnel/ssh_config (root-owned, mode 0644).
# The private key and known_hosts are deliberately not versioned.
Host ddg-content-gateway
    HostName 78.17.7.191
    Port 2222
    User ddg-content-tunnel
    IdentityFile /etc/ddg-content-tunnel/id_ed25519
    IdentitiesOnly yes
    UserKnownHostsFile /etc/ddg-content-tunnel/known_hosts
    GlobalKnownHostsFile /dev/null
    StrictHostKeyChecking yes
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PreferredAuthentications publickey
    BatchMode yes
    RequestTTY no
    EscapeChar none
    ExitOnForwardFailure yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ConnectTimeout 10
    TCPKeepAlive yes
