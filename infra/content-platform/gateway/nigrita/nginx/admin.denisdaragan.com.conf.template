# Add as an additional server block to the existing Nginx on nigrita.
# Do not install until DNS and the certificate are deliberately prepared.
# This is one SNI virtual host inside the existing Nginx process, not a new
# listener and not a service on ddg-bridge-01.
server {
    listen 80;
    listen [::]:80;
    server_name admin.denisdaragan.com;

    # Keep ACME validation compatible with the existing certificate workflow.
    # If the existing Nginx has a shared challenge location, use that instead.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme-challenge;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.denisdaragan.com;

    # Replace with paths managed by nigrita's existing certificate process.
    # Certificates and private keys do not belong in this repository.
    ssl_certificate /etc/letsencrypt/live/admin.denisdaragan.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.denisdaragan.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    client_max_body_size 50m;
    limit_req_status 429;

    # The first administrator is created only by the local one-shot command.
    # Keep Payload's built-in empty-database registration route off the public
    # gateway even if an empty database is ever restored by mistake.
    location ~ ^/api/users/first-register/?$ {
        return 404;
    }

    location ~ ^/api/users/login/?$ {
        limit_req zone=ddg_admin_login burst=3 nodelay;
        proxy_pass http://127.0.0.1:18055;
        proxy_http_version 1.1;
        proxy_set_header Host $server_name;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        limit_req zone=ddg_admin_general burst=100 nodelay;
        # The reverse SSH listener is loopback-only on nigrita.
        proxy_pass http://127.0.0.1:18055;
        proxy_http_version 1.1;
        proxy_set_header Host $server_name;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
