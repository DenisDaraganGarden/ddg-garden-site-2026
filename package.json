{
  "name": "denis-daragan-design",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:lan": "node ./node_modules/vite/bin/vite.js --host --port 41211 --strictPort",
    "build": "node ./node_modules/vite/bin/vite.js build && node scripts/seo/build-seo.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "content:export": "node scripts/content/export-registry-manifest.mjs",
    "test:content": "node --test tests/portfolio-content/*.test.mjs",
    "cleanup:playwright": "node scripts/cleanup-playwright.mjs",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "optimize:portfolio": "node scripts/optimize-portfolio-images.mjs --prune-originals",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "smoke": "node scripts/smoke-test.mjs",
    "handoff": "node scripts/handoff.mjs",
    "check:seo": "node scripts/seo/build-seo.check.mjs",
    "check:local-guard": "node scripts/localGuard.check.mjs",
    "check:fast": "node scripts/check-fast.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.37.0",
    "react-router-dom": "^6.30.3",
    "react-spring": "^10.0.3",
    "three": "^0.183.2",
    "three-custom-shader-material": "^6.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "playwright": "^1.58.2",
    "sharp": "^0.35.2",
    "vite": "^5.2.0"
  }
}
