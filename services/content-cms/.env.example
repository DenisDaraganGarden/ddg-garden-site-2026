# For standalone development only. Production values live in
# infra/content-platform/.env and are injected by Compose. Never commit them.
# Keep the password URL-safe; a 64-character hex value is recommended.
DATABASE_URL=postgresql://ddg_content:CHANGE_ME_HEX_ONLY@postgres:5432/ddg_content
PAYLOAD_SECRET=CHANGE_ME_64_OR_MORE_RANDOM_CHARACTERS
PAYLOAD_PUBLIC_SERVER_URL=https://admin.example.com
PUBLIC_MEDIA_ORIGIN=https://content.example.com
SITE_ORIGIN=https://example.com
UPLOAD_DIR=/app/uploads
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production
