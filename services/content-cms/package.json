{
  "name": "ddg-content-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload",
    "migrate": "npm run payload -- migrate",
    "migrate:status": "npm run payload -- migrate:status",
    "migrate:create": "npm run payload -- migrate:create",
    "generate:types": "npm run payload -- generate:types",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "lint:config": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "cross-env": "7.0.3",
    "graphql": "16.12.0",
    "next": "16.3.3",
    "payload": "3.88.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "dompurify": "3.4.14"
  }
}
